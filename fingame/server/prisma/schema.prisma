datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  password       String
  level          Int             @default(1)
  xp             Int             @default(0)
  streak         Int             @default(0)
  tourCompleted  Boolean         @default(false)
  monthlyBudget  Float           @default(10000)
  createdAt      DateTime        @default(now())
  expenses       Expense[]
  quests         UserQuest[]
  badges         UserBadge[]
  budgetHistory  BudgetHistory[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  category    String
  note        String?
  date        DateTime @default(now())
  xpAwarded   Int      @default(0)
  isRecurring Boolean  @default(false)
  recurringId String?
  user        User     @relation(fields: [userId], references: [id])
}

model RecurringExpense {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  category  String
  note      String?
  dayOfMonth Int     // 1-28, day to auto-log each month
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastLoggedAt DateTime?
  user      User     @relation(fields: [userId], references: [id])
}

model BudgetHistory {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  month     Int      // 1-12
  year      Int
  setAt     DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Quest {
  id          String      @id @default(cuid())
  name        String
  description String
  xpReward    Int
  targetValue Float
  type        String
  userQuests  UserQuest[]
}

model UserQuest {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  progress  Float    @default(0)
  completed Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  quest     Quest    @relation(fields: [questId], references: [id])
}

model Badge {
  id         String      @id @default(cuid())
  name       String
  icon       String
  xpRequired Int
  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
}
